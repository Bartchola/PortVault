{
  "name": "portvault",
  "productName": "PortVault",
  "version": "0.2.0",
  "description": "Launcher de jogos portados e recompilados para PC",
  "author": "Sua Comunidade de Games",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "node test-updater.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "rimraf dist && electron-vite build && electron-builder --win --publish never",
    "dist:portable": "rimraf dist && electron-vite build && electron-builder --win --publish never portable"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.portvault.launcher",
    "productName": "PortVault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PortVault"
    }
  }
}
